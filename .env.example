# RFC STORE — Environment Variables Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to Git.
# ============================================================

# ── Supabase ──────────────────────────────────────────────
# Public (browser-safe): used in both client and server components
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# PRIVATE (server-only): NEVER expose to browser or commit to Git
# Used only in server actions and API routes with elevated permissions
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-expose-to-browser

# ── Site ──────────────────────────────────────────────────
# The canonical public URL of the deployed application
NEXT_PUBLIC_SITE_URL=https://rfc-store.vercel.app

# ── Future: Payment Gateway ───────────────────────────────
# Add payment provider keys here in a future phase
# STRIPE_SECRET_KEY=sk_live_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── Future: Email Service ─────────────────────────────────
# RESEND_API_KEY=re_...
# EMAIL_FROM=noreply@revivefightclub.com
