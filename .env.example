# RFC STORE — Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to Git (.gitignore already excludes it).
# ============================================================

# ── Supabase (REQUIRED) ────────────────────────────────────
# Public (browser-safe): used in client + server components
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# PRIVATE (server-only — NEVER expose to browser, NEVER commit to Git)
# Used ONLY in server actions and API routes for admin/service operations
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-expose-to-browser

# ── Site URL (REQUIRED) ────────────────────────────────────
# Set to your actual production domain before deploying
# Testing:    https://rfc-store.vercel.app
# Production: https://rfcstore.in  (or your Hostinger domain)
NEXT_PUBLIC_SITE_URL=https://rfc-store.vercel.app

# ── Admin Notifications (optional) ────────────────────────
# Email address to receive admin alerts for new orders
ADMIN_NOTIFICATION_EMAIL=admin@revivefightclub.com

# ── Payment Gateway ────────────────────────────────────────
# Razorpay — ACTIVE payment gateway for RFC Store
#
# Test credentials (from Razorpay Dashboard > Settings > API Keys > Test Mode):
#   NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...
#   RAZORPAY_KEY_SECRET=...
#
# Production credentials (provide before go-live):
#   NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_...
#   RAZORPAY_KEY_SECRET=...
#
# Set NEXT_PUBLIC_RAZORPAY_KEY_ID to ENABLE online payment at checkout.
# Leave blank/unset to show COD only.
#
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET_HERE

# Razorpay Webhook Secret
# Generate at: Razorpay Dashboard > Settings > Webhooks > Create Webhook
# Webhook URL: https://your-domain.com/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET_HERE

# ── Email (Brevo — ACTIVE) ──────────────────────────────────
# Brevo API key (formerly Sendinblue)
# Generate at: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=YOUR_BREVO_API_KEY_HERE
BREVO_FROM_NAME=Revive Fight Club
BREVO_FROM_EMAIL=revivefightclub@gmail.com

# ── SMS Notifications (optional) ───────────────────────────
# Option 1: MSG91 (recommended for India)
# MSG91_API_KEY=...
# MSG91_SENDER_ID=RFCSTR
# MSG91_TEMPLATE_ID=...
#
# Option 2: Twilio
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...               ← PRIVATE server-only
# TWILIO_FROM_NUMBER=+1...

# ── Security (optional hardening) ─────────────────────────
# Generate random 32+ char strings for additional webhook security
# WEBHOOK_SECRET=...                  ← PRIVATE server-only

# ── Sentry Error Monitoring ─────────────────────────────────────────────────
# Create a project at https://sentry.io, then copy the DSN and credentials.
# NEXT_PUBLIC_SENTRY_DSN is safe to expose (public ingest endpoint).
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_AUTH_TOKEN=           # Build-time only — used for source map upload
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=rfc-store

# ── Store Business Information ──────────────────────────────────────────────
# Required for GST invoice generation. Set before your first production invoice.
STORE_PHONE=+91-XXXXXXXXXX
STORE_ADDRESS=Your Business Address, City, State - PIN
STORE_GST_NUMBER=YOUR_GST_NUMBER_HERE
