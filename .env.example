# RFC STORE — Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to Git (.gitignore already excludes it).
# ============================================================

# ── Supabase (REQUIRED) ────────────────────────────────────
# Public (browser-safe): used in client + server components
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# PRIVATE (server-only — NEVER expose to browser, NEVER commit to Git)
# Used ONLY in server actions and API routes for admin/service operations
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-expose-to-browser

# ── Site URL (REQUIRED) ────────────────────────────────────
# Set to your actual production domain before deploying
# Testing:    https://rfc-store.vercel.app
# Production: https://rfcstore.in  (or your Hostinger domain)
NEXT_PUBLIC_SITE_URL=https://rfc-store.vercel.app

# ── Admin Notifications (optional) ────────────────────────
# Email address to receive admin alerts for new orders
ADMIN_NOTIFICATION_EMAIL=admin@revivefightclub.com

# ── Payment Gateway (PENDING — not yet connected) ──────────
# Razorpay (recommended for India)
# RAZORPAY_KEY_ID=rzp_live_...          ← public (safe for browser)
# RAZORPAY_KEY_SECRET=...               ← PRIVATE server-only
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_...
#
# Cashfree (alternative)
# CASHFREE_APP_ID=...
# CASHFREE_SECRET_KEY=...               ← PRIVATE server-only
#
# Stripe (international)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_SECRET_KEY=sk_live_...         ← PRIVATE server-only
# STRIPE_WEBHOOK_SECRET=whsec_...       ← PRIVATE server-only

# ── Email Notifications (PENDING — not yet connected) ──────
# Choose ONE provider and configure:
#
# Option 1: Resend (recommended — simple REST API)
# RESEND_API_KEY=re_...
# EMAIL_FROM=orders@revivefightclub.com
#
# Option 2: SendGrid
# SENDGRID_API_KEY=SG...
# EMAIL_FROM=orders@revivefightclub.com
#
# Option 3: SMTP (Hostinger mail or Gmail)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=587
# SMTP_USER=orders@revivefightclub.com
# SMTP_PASS=your-email-password        ← PRIVATE server-only
# EMAIL_FROM=orders@revivefightclub.com

# ── SMS Notifications (PENDING — not yet connected) ────────
# Option 1: MSG91 (recommended for India)
# MSG91_API_KEY=...
# MSG91_SENDER_ID=RFCSTR
# MSG91_TEMPLATE_ID=...
#
# Option 2: Twilio
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...               ← PRIVATE server-only
# TWILIO_FROM_NUMBER=+1...

# ── Security (optional hardening) ─────────────────────────
# Webhook signature secrets — generate random 32+ char strings
# WEBHOOK_SECRET=...                  ← PRIVATE server-only
